<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="mainPane"
            fx:controller="com.myhomelibcorp.ui.controller.MainController"
            style="-fx-background-color: -mhl-panel;">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Файл">
                    <MenuItem text="Імпортувати книгу / архів..." onAction="#handleImportFb2"/>
                    <MenuItem text="Імпортувати каталог..." onAction="#handleImportDirectory"/>
                    <MenuItem fx:id="exportMenuItem" text="Експортувати книги / на пристрій..." onAction="#handleExport"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Імпорт користувацьких даних..." onAction="#handleImportUserData"/>
                    <MenuItem text="Експорт користувацьких даних..." onAction="#handleExportUserData"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Резервна копія..." onAction="#handleBackup"/>
                    <MenuItem text="Відновити з копії..." onAction="#handleRestore"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Вийти" onAction="#handleExit"/>
                </Menu>

                <Menu text="Бібліотека">
                    <MenuItem text="Головна" onAction="#handleHome"/>
                    <MenuItem text="Книги" onAction="#onAllBooks"/>
                    <MenuItem text="Автори" onAction="#onAuthors"/>
                    <MenuItem text="Серії" onAction="#onSeries"/>
                    <MenuItem text="Жанри" onAction="#onGenres"/>
                    <MenuItem text="Групи" onAction="#onGroups"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Нові книги" onAction="#onNewBooks"/>
                    <MenuItem text="Стеження за авторами" onAction="#onFollowedAuthors"/>
                    <MenuItem fx:id="updatesMenuItem" text="Оновлення каталогу" onAction="#onUpdates"/>
                    <MenuItem text="Прочитані" onAction="#onAlreadyRead"/>
                    <MenuItem text="Історія читання" onAction="#onHistory"/>
                    <SeparatorMenuItem/>
                    <Menu text="Групи — дії">
                        <MenuItem text="Додати групу..." onAction="#handleAddGroup"/>
                        <MenuItem text="Редагувати групу..." onAction="#handleEditGroup"/>
                        <MenuItem text="Видалити групу" onAction="#handleDeleteGroup"/>
                        <MenuItem text="Очистити групу" onAction="#handleClearGroup"/>
                    </Menu>
                    <MenuItem text="Очистити історію читання" onAction="#onClearHistory"/>
                </Menu>

                <Menu text="Колекція">
                    <MenuItem fx:id="collectionsMenuItem" text="Керування колекціями..." onAction="#onCollections"/>
                    <MenuItem text="Створити колекцію..." onAction="#handleNewCollection"/>
                    <MenuItem text="Майстер створення колекції..." onAction="#handleCollectionWizard"/>
                    <MenuItem text="Підключити існуючу .hlc2 / SQLite..." onAction="#handleAttachCollection"/>
                    <MenuItem text="Властивості колекції..." onAction="#handleCollectionProperties"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Оновити з INPX..." onAction="#handleUpdateCollectionManual"/>
                    <MenuItem text="Оновити з мережі..." onAction="#handleUpdateCollectionNetwork"/>
                    <MenuItem text="Скасувати оновлення" onAction="#handleCancelCollectionUpdate"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Копіювати вибрані книги в іншу колекцію..." onAction="#handleCopyToCollection"/>
                    <MenuItem text="Скинути навігацію" onAction="#handleResetNavigation"/>
                </Menu>

                <Menu text="Книга">
                    <MenuItem fx:id="openInternalMenuItem" text="Відкрити у Reader" onAction="#handleOpenNewReader"/>
                    <MenuItem fx:id="openExternalMenuItem" text="Відкрити у зовнішній читалці" onAction="#handleOpenExternalReader"/>
                    <MenuItem text="Завантажити" onAction="#handleDownloadBook"/>
                    <MenuItem text="Видалити локальну копію" onAction="#handleRemoveLocalCopy"/>
                    <MenuItem text="Скасувати завантаження" onAction="#handleCancelDownload"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Редагувати метадані..." onAction="#handleEditMetadata"/>
                    <MenuItem text="Видалити запис(и) з каталогу" onAction="#handleDeleteBook"/>
                    <MenuItem text="Експортувати..." onAction="#handleExport"/>
                </Menu>

                <Menu text="Reader">
                    <MenuItem text="Відкрити" onAction="#handleOpenNewReader"/>
                    <MenuItem text="Закрити" onAction="#handleCloseReader"/>
                    <MenuItem text="Відкрити зовнішньою програмою" onAction="#handleOpenExternalReader"/>
                </Menu>

                <Menu fx:id="viewMenu" text="Вигляд">
                    <MenuItem fx:id="refreshMenuItem" text="Оновити" onAction="#handleRefresh"/>
                    <SeparatorMenuItem/>
                    <CheckMenuItem fx:id="leftSidebarMenuItem" text="Ліва панель" selected="true" onAction="#handleToggleLeftSidebar"/>
                    <CheckMenuItem fx:id="rightSidebarMenuItem" text="Права панель" selected="true" onAction="#handleToggleRightSidebar"/>
                    <MenuItem text="Показати колонки..." onAction="#handleShowColumns"/>
                    <SeparatorMenuItem/>
                    <Menu fx:id="recentBooksMenu" text="Недавні книги"/>
                    <Menu fx:id="languageMenu" text="Мова / Language"/>
                </Menu>

                <Menu text="Інструменти">
                    <MenuItem fx:id="importInpxMenuItem" text="Імпорт INPX..." onAction="#handleImportInpx"/>
                    <MenuItem text="Імпорт каталогу..." onAction="#handleImportDirectory"/>
                    <MenuItem text="Синхронізувати папку..." onAction="#handleSyncFolder"/>
                    <SeparatorMenuItem/>
                    <Menu text="Експорт поточного списку">
                        <MenuItem text="HTML..." onAction="#handleExportListHtml"/>
                        <MenuItem text="TXT..." onAction="#handleExportListTxt"/>
                        <MenuItem text="RTF..." onAction="#handleExportListRtf"/>
                    </Menu>
                    <SeparatorMenuItem/>
                    <MenuItem text="Перевірити цілісність..." onAction="#handleCheckIntegrity"/>
                    <MenuItem text="Статистика" onAction="#handleStatistics"/>
                    <MenuItem text="Операції" onAction="#onOperations"/>
                    <MenuItem text="Перебудувати індекс..." onAction="#handleRebuildIndex"/>
                    <MenuItem text="Оптимізувати БД (VACUUM)" onAction="#handleVacuum"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="bookActionsMenuItem" text="Дії з книгою / скрипти..." onAction="#handleBookActions"/>
                    <MenuItem fx:id="customizeActionsMenuItem" text="Команди та гарячі клавіші..." onAction="#handleCustomizeActions"/>
                    <MenuItem fx:id="opdsMenuItem" text="OPDS сервер..." onAction="#handleOpds"/>
                </Menu>

                <Menu text="Налаштування">
                    <MenuItem fx:id="settingsMenuItem" text="Налаштування..." onAction="#handleSettings"/>
                </Menu>

                <Menu text="Допомога">
                    <MenuItem fx:id="helpMenuItem" text="Довідка (F1)" onAction="#handleHelp"/>
                    <MenuItem text="INPX / online" onAction="#handleInpxHelp"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Про програму" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <ToolBar styleClass="main-toolbar-wrap">
                <Button fx:id="backButton" text="←" onAction="#handleBack" disable="true"/>
                <Button fx:id="forwardButton" text="→" onAction="#handleForward" disable="true"/>
                <Separator orientation="VERTICAL"/>
                <Button text="🏠" onAction="#handleHome"/>
                <Separator orientation="VERTICAL"/>
                <TextField fx:id="searchField" promptText="🔍 Пошук..." prefWidth="300"/>
                <Button text="🔍" onAction="#handleSearch"/>
                <Button text="✕" onAction="#handleClearSearch" focusTraversable="false">
                    <tooltip><Tooltip text="Очистити пошук"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="+Імпорт" onAction="#handleImportDirectory"/>
                <Button text="+Книга" onAction="#handleAddBook"/>
                <Separator orientation="VERTICAL"/>
                <Button text="⭐ Оцінити" onAction="#handleBatchRate" style="-fx-background-color: -mhl-warning; -fx-text-fill: -mhl-text;"/>
                <Button text="📊 Прогрес" onAction="#handleBatchProgress" style="-fx-background-color: -mhl-accent; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="📖 Прочитано" onAction="#handleBatchMarkRead" style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="📂 Додати до групи" onAction="#handleBatchAddToGroup" style="-fx-background-color: -mhl-accent; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="✖ Зняти вибір" onAction="#handleClearSelection" style="-fx-background-color: -mhl-muted-text; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="🌳" onAction="#handleToggleView" style="-fx-background-color: -mhl-accent-secondary; -fx-text-fill: -mhl-on-accent;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="📤 Експорт" onAction="#handleExport" style="-fx-background-color: -mhl-warning; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="📦 INPX" onAction="#handleExportInpx" style="-fx-background-color: -mhl-accent-secondary; -fx-text-fill: -mhl-on-accent;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="💾 Backup" onAction="#handleBackup" style="-fx-background-color: -mhl-warning; -fx-text-fill: -mhl-on-accent;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="⬇ Завантажити вибрані" onAction="#handleDownloadBook"/>
                <Button text="⌫ Видалити локальну" onAction="#handleRemoveLocalCopy"/>
                <Button text="✕ Скасувати завантаження" onAction="#handleCancelDownload"/>
                <Button text="📖 Reader" onAction="#handleOpenNewReader" style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent; -fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="⚙" onAction="#handleSettings"/>
            </ToolBar>
        </VBox>
    </top>

    <left>
        <StackPane fx:id="leftSidebarContainer">
            <fx:include source="navigation-panel.fxml"/>
        </StackPane>
    </left>

    <center>
        <VBox VBox.vgrow="ALWAYS" minWidth="0.0" style="-fx-background-color: -mhl-panel;">
            <fx:include source="alphabet-toolbar-view.fxml"/>
            <StackPane fx:id="workspaceStackPane" minWidth="0.0" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <right>
        <VBox fx:id="rightSidebarContainer"
              style="-fx-padding: 5; -fx-pref-width: 320; -fx-max-width: 350; -fx-background-color: -mhl-panel;"
              VBox.vgrow="ALWAYS">
            <fx:include source="details.fxml"/>
        </VBox>
    </right>

    <bottom>
        <fx:include source="statusbar.fxml"/>
    </bottom>
</BorderPane>