<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="mainPane"
            fx:controller="com.myhomelibcorp.ui.controller.MainController"
            style="-fx-background-color: #f0f0f0;">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Колекція">
                    <MenuItem text="Створити колекцію..." onAction="#handleNewCollection"/>
                    <MenuItem text="Перейменувати колекцію..." onAction="#handleRenameCollection"/>
                    <MenuItem text="Видалити колекцію" onAction="#handleDeleteCollection"/>
                    <MenuItem text="Вибрати колекцію" onAction="#handleSelectCollection"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Вийти" onAction="#handleExit"/>
                </Menu>
                <Menu text="Група">
                    <MenuItem text="Додати групу..." onAction="#handleAddGroup"/>
                    <MenuItem text="Редагувати групу..." onAction="#handleEditGroup"/>
                    <MenuItem text="Видалити групу" onAction="#handleDeleteGroup"/>
                </Menu>
                <Menu text="Редагування">
                    <MenuItem text="Редагувати метадані..." onAction="#handleEditMetadata"/>
                    <MenuItem text="Видалити книгу" onAction="#handleDeleteBook"/>
                </Menu>
                <Menu text="Вигляд">
                    <MenuItem text="Оновити" onAction="#handleRefresh"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Показати колонки..." onAction="#handleShowColumns"/>
                </Menu>
                <Menu text="Інструменти">
                    <MenuItem text="Імпорт FB2..." onAction="#handleImportFb2"/>
                    <MenuItem text="Імпорт INPX..." onAction="#handleImportInpx"/>
                    <MenuItem text="Імпорт каталогу..." onAction="#handleImportDirectory"/>
                    <MenuItem text="Експорт..." onAction="#handleExport"/>
                    <MenuItem text="Перебудувати індекс..." onAction="#handleRebuildIndex"/>
                </Menu>
                <Menu text="Допомога">
                    <MenuItem text="Про програму" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <!-- Панель інструментів -->
            <ToolBar>
                <Button fx:id="backButton" text="←" onAction="#handleBack" disable="true"/>
                <Button fx:id="forwardButton" text="→" onAction="#handleForward" disable="true"/>
                <Separator/>
                <Button text="🏠" onAction="#handleHome"/>
                <Separator/>
                <TextField fx:id="searchField" promptText="🔍 Пошук..." prefWidth="300"/>
                <Button text="🔍" onAction="#handleSearch"/>
                <Separator/>
                <Button text="+Імпорт" onAction="#handleImportDirectory"/>
                <Button text="+Книга" onAction="#handleAddBook"/>
                <Button text="💾 Backup" onAction="#handleBackup"/>
                <Separator/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="⚙" onAction="#handleSettings"/>
            </ToolBar>
        </VBox>
    </top>

    <left>
        <VBox style="-fx-padding: 5; -fx-background-color: #f5f5f5; -fx-pref-width: 200;">
            <fx:include source="navigation.fxml"/>
        </VBox>
    </left>

    <center>
        <!-- Тут буде робоча область (Workspace), яка встановлюється програмою -->
        <!-- За замовчуванням завантажуємо Dashboard -->
        <fx:include source="dashboard.fxml"/>
    </center>

    <right>
        <VBox style="-fx-padding: 5; -fx-pref-width: 300; -fx-background-color: #fafafa;">
            <fx:include source="details.fxml"/>
        </VBox>
    </right>

    <bottom>
        <fx:include source="statusbar.fxml"/>
    </bottom>
</BorderPane>