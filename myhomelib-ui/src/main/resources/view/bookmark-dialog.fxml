<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.reader.BookmarkDialogController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa;"
      prefWidth="500" prefHeight="400">

    <Label text="📖 Закладки" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="bookmarksListView" VBox.vgrow="ALWAYS"/>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="✕ Закрити" onAction="#onClose" style="-fx-background-color: #9e9e9e; -fx-text-fill: white;"/>
    </HBox>
</VBox>