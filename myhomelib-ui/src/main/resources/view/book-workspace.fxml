<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.book.BookWorkspaceController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: -mhl-panel;">

    <HBox spacing="20" alignment="TOP_LEFT">
        <ImageView fx:id="coverImageView" fitWidth="180" fitHeight="250" preserveRatio="true"
                   style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 12, 0, 0, 4);"/>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" text="Назва" wrapText="true" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="authorLabel" text="Автор" style="-fx-font-size: 14px;"/>
            <Label fx:id="seriesLabel" text="Серія"/>
            <Label fx:id="genresLabel" text="Жанри"/>
            <Label fx:id="languageLabel" text="Мова"/>
            <Label fx:id="yearLabel" text="Рік"/>
            <Label fx:id="publisherLabel" text="Видавництво"/>
            <Label fx:id="isbnLabel" text="ISBN"/>
            <Label fx:id="formatLabel" text="Формат"/>
            <Label fx:id="sizeLabel" text="Розмір"/>
            <Label fx:id="ratingLabel" text="Рейтинг"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <ProgressBar fx:id="readingProgress" prefWidth="150"/>
                <Label fx:id="progressLabel" text="0%"/>
            </HBox>
        </VBox>
    </HBox>

    <Label text="Анотація:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <TextArea fx:id="annotationArea" wrapText="true" prefHeight="120" editable="false"/>

    <HBox spacing="10">
        <Button text="Відкрити у зовнішній програмі" onAction="#onOpen" style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent;"/>
        <Button text="Читати у MyHomeLib" onAction="#onRead" style="-fx-background-color: -mhl-accent; -fx-text-fill: -mhl-on-accent;"/>
        <Button text="Завантажити" onAction="#onDownload"/>
        <Button text="Редагувати" onAction="#onEdit" style="-fx-background-color: -mhl-warning; -fx-text-fill: -mhl-on-accent;"/>
        <Button text="Відкрити папку" onAction="#onOpenFolder"/>
        <Button text="Додати до групи" onAction="#onAddToCollection"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Видалити запис із каталогу" onAction="#onDeleteBook" style="-fx-background-color: -mhl-danger; -fx-text-fill: -mhl-on-accent;"/>
        <Button text="← Назад" onAction="#onBack"/>
    </HBox>
</VBox>