<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.collection.CollectionWorkspaceController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: -mhl-background;">

    <Label text="ui.fxml.collection_workspace.collections" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <SplitPane dividerPositions="0.3" VBox.vgrow="ALWAYS">
        <items>
            <!-- Ліва панель: список колекцій -->
            <VBox spacing="5" style="-fx-padding: 5;">
                <HBox spacing="5">
                    <Button text="ui.fxml.collection_workspace.empty" onAction="#onCreateCollection"/>
                    <Button fx:id="activateButton" text="ui.fxml.collection_workspace.activate" onAction="#onActivateCollection" style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent; -fx-font-weight: bold;"/>
                    <Button fx:id="renameButton" text="ui.fxml.collection_workspace.value" accessibleText="ui.fxml.collection_workspace.rename_collection" onAction="#onRenameCollection" prefWidth="30"/>
                    <Button fx:id="deleteButton" text="ui.fxml.collection_workspace.value_eeaa9e0" accessibleText="ui.fxml.collection_workspace.delete_collection" onAction="#onDeleteCollection" prefWidth="30"/>
                    <Button text="ui.fxml.collection_workspace.value_592a38e" accessibleText="ui.fxml.collection_workspace.refresh_collections" onAction="#onRefresh" prefWidth="30"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <ListView fx:id="collectionsListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Права панель: деталі колекції -->
            <VBox fx:id="collectionDetailsBox" spacing="10" style="-fx-padding: 10;">
                <Label fx:id="collectionNameLabel" text="ui.fxml.collection_workspace.collection" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="runtimeStateLabel" text="ui.fxml.collection_workspace.state_ready" wrapText="true"/>
                <Label fx:id="activeCollectionLabel" text="ui.fxml.collection_workspace.active_collection_no"/>
                <Label fx:id="rootFolderLabel" text="ui.fxml.collection_workspace.folder" wrapText="true"/>
                <Label fx:id="dbFileLabel" text="ui.fxml.collection_workspace.database" wrapText="true"/>
                <Label fx:id="collectionTypeLabel" text="ui.fxml.collection_workspace.type"/>
                <TitledPane text="ui.fxml.collection_workspace.automatic_local_inpx_zip_update" expanded="false">
                    <content>
                        <VBox spacing="7" style="-fx-padding: 8;">
                            <Label text="ui.fxml.collection_workspace.the_watcher_monitors_only_the_specified_sour_3ea6ea1" wrapText="true"/>
                            <HBox spacing="6">
                                <TextField fx:id="sourceFileField" promptText="ui.fxml.collection_workspace.path_to_inpx_or_zip" HBox.hgrow="ALWAYS"/>
                                <Button text="ui.fxml.collection_workspace.browse" onAction="#onBrowseSource"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <CheckBox fx:id="autoUpdateEnabledCheckBox" text="ui.fxml.collection_workspace.automatically_watch_for_changes"/>
                                <Button text="ui.fxml.collection_workspace.save" onAction="#onSaveSourceMonitor"/>
                                <Button fx:id="sourceCheckButton" text="ui.fxml.collection_workspace.check_now" onAction="#onCheckSourceNow"/>
                            </HBox>
                            <Label fx:id="sourceStatusLabel" text="ui.fxml.collection_workspace.auto_update_source_is_not_configured" wrapText="true"/>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane text="ui.fxml.collection_workspace.incoming_folder_automatic_import" expanded="false">
                    <content>
                        <VBox spacing="7" style="-fx-padding: 8;">
                            <Label text="ui.fxml.collection_workspace.a_file_is_imported_only_after_a_delay_and_st_8ef95b8" wrapText="true"/>
                            <HBox spacing="6">
                                <TextField fx:id="incomingFolderField" promptText="ui.fxml.collection_workspace.folder_with_new_books_archives" HBox.hgrow="ALWAYS"/>
                                <Button text="ui.fxml.collection_workspace.browse" onAction="#onBrowseIncomingFolder"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <CheckBox fx:id="incomingFolderEnabledCheckBox" text="ui.fxml.collection_workspace.automatically_import_stable_files"/>
                                <Button text="ui.fxml.collection_workspace.save" onAction="#onSaveIncomingFolder"/>
                                <Button fx:id="incomingFolderScanButton" text="ui.fxml.collection_workspace.scan_now" onAction="#onScanIncomingFolder"/>
                            </HBox>
                            <Label fx:id="incomingFolderStatusLabel" text="ui.fxml.collection_workspace.incoming_folder_is_not_configured" wrapText="true"/>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane text="ui.fxml.collection_workspace.maintenance_cleanup_repair" expanded="false">
                    <content>
                        <VBox spacing="7" style="-fx-padding: 8;">
                            <Label text="ui.fxml.collection_workspace.safe_workflow_analyze_preview_dry_run_apply_37fc402" wrapText="true"/>
                            <HBox spacing="6">
                                <Button fx:id="maintenanceAnalyzeButton" text="ui.fxml.collection_workspace.analyze" onAction="#onAnalyzeMaintenance"/>
                                <Button fx:id="maintenanceDryRunButton" text="ui.fxml.collection_workspace.dry_run" onAction="#onDryRunMaintenance" disable="true"/>
                                <Button fx:id="maintenanceApplyButton" text="ui.fxml.collection_workspace.apply_fixes" onAction="#onApplyMaintenance" disable="true"/>
                            </HBox>
                            <Label fx:id="maintenanceStatusLabel" text="ui.fxml.collection_workspace.analysis_has_not_been_run_yet" wrapText="true"/>
                            <TextArea fx:id="maintenanceReportArea" editable="false" wrapText="false" prefRowCount="8"/>
                        </VBox>
                    </content>
                </TitledPane>

            </VBox>
        </items>
    </SplitPane>
</VBox>