<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.collection.CollectionWorkspaceController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: -mhl-background;">

    <Label text="⭐ Колекції" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <SplitPane dividerPositions="0.3" VBox.vgrow="ALWAYS">
        <items>
            <!-- Ліва панель: список колекцій -->
            <VBox spacing="5" style="-fx-padding: 5;">
                <HBox spacing="5">
                    <Button text="+ Порожня" onAction="#onCreateCollection"/>
                    <Button fx:id="activateButton" text="▶ Активувати" onAction="#onActivateCollection" style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent; -fx-font-weight: bold;"/>
                    <Button fx:id="renameButton" text="✏️" onAction="#onRenameCollection" prefWidth="30"/>
                    <Button fx:id="deleteButton" text="🗑" onAction="#onDeleteCollection" prefWidth="30"/>
                    <Button text="🔄" onAction="#onRefresh" prefWidth="30"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <ListView fx:id="collectionsListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Права панель: деталі колекції -->
            <VBox fx:id="collectionDetailsBox" spacing="10" style="-fx-padding: 10;">
                <Label fx:id="collectionNameLabel" text="Колекція" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="runtimeStateLabel" text="Стан: ● Готова" wrapText="true"/>
                <Label fx:id="activeCollectionLabel" text="Активна колекція: ні"/>
                <Label fx:id="rootFolderLabel" text="Папка: —" wrapText="true"/>
                <Label fx:id="dbFileLabel" text="БД: —" wrapText="true"/>
                <Label fx:id="collectionTypeLabel" text="Тип: —"/>
                <TitledPane text="Автооновлення локального INPX/ZIP" expanded="false">
                    <content>
                        <VBox spacing="7" style="-fx-padding: 8;">
                            <Label text="Watcher стежить тільки за вказаним source-файлом; зміни обробляються після debounce." wrapText="true"/>
                            <HBox spacing="6">
                                <TextField fx:id="sourceFileField" promptText="Шлях до .inpx або .zip" HBox.hgrow="ALWAYS"/>
                                <Button text="Огляд..." onAction="#onBrowseSource"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <CheckBox fx:id="autoUpdateEnabledCheckBox" text="Автоматично відстежувати зміни"/>
                                <Button text="Зберегти" onAction="#onSaveSourceMonitor"/>
                                <Button fx:id="sourceCheckButton" text="Перевірити зараз" onAction="#onCheckSourceNow"/>
                            </HBox>
                            <Label fx:id="sourceStatusLabel" text="Джерело автооновлення не налаштовано" wrapText="true"/>
                        </VBox>
                    </content>
                </TitledPane>

                <TitledPane text="Maintenance / Cleaner / Repair" expanded="false">
                    <content>
                        <VBox spacing="7" style="-fx-padding: 8;">
                            <Label text="Безпечний workflow: Analyze → Preview → Dry run → Apply. Фізичні orphan-файли автоматично не видаляються." wrapText="true"/>
                            <HBox spacing="6">
                                <Button fx:id="maintenanceAnalyzeButton" text="Аналіз" onAction="#onAnalyzeMaintenance"/>
                                <Button fx:id="maintenanceDryRunButton" text="Dry run" onAction="#onDryRunMaintenance" disable="true"/>
                                <Button fx:id="maintenanceApplyButton" text="Застосувати repair..." onAction="#onApplyMaintenance" disable="true"/>
                            </HBox>
                            <Label fx:id="maintenanceStatusLabel" text="Аналіз ще не запускався" wrapText="true"/>
                            <TextArea fx:id="maintenanceReportArea" editable="false" wrapText="false" prefRowCount="8"/>
                        </VBox>
                    </content>
                </TitledPane>

            </VBox>
        </items>
    </SplitPane>
</VBox>