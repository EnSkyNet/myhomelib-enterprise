<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.table.BookTableController"
      spacing="5" style="-fx-padding: 10;">

    <HBox spacing="7" alignment="CENTER_LEFT">
        <Button text="Фільтри…" onAction="#openGlobalFilters"/>
        <Label fx:id="filterIndicatorLabel" text="Фільтр вимкнено"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Швидкий фільтр:"/>
        <ComboBox fx:id="quickFilterColumnComboBox" prefWidth="125"/>
        <TextField fx:id="quickFilterValueField" promptText="Введіть значення…" HBox.hgrow="ALWAYS"/>
        <Button text="Застосувати" onAction="#applyQuickFilter"/>
        <Button text="✕" onAction="#clearQuickFilter" tooltip="Очистити швидкий фільтр"/>
        <Button text="Колонки…" onAction="#showColumnChooser"/>
        <Button text="Скинути вигляд" onAction="#resetTableProfile"/>
    </HBox>

    <TableView fx:id="bookTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Назва" prefWidth="250"/>
            <TableColumn fx:id="authorColumn" text="Автор" prefWidth="150"/>
            <TableColumn fx:id="seriesColumn" text="Серія" prefWidth="100"/>
            <TableColumn fx:id="genresColumn" text="Жанри" prefWidth="100"/>
            <TableColumn fx:id="fileSizeColumn" text="Розмір" prefWidth="90"/>
            <TableColumn fx:id="rateColumn" text="Оцінка" prefWidth="80"/>
            <TableColumn fx:id="progressColumn" text="Прогрес" prefWidth="80"/>
            <TableColumn fx:id="dateColumn" text="Додано" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
        <Label text="Поточна:"/>
        <Label fx:id="currentBookLabel" text="—"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="batchSelectionLabel" text="Пакетно вибрано: 0"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Розмір сторінки:"/>
        <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
        <Button fx:id="prevPageButton" text="◀"/>
        <Label fx:id="pageInfoLabel" text="Сторінка 1 з 1"/>
        <Button fx:id="nextPageButton" text="▶"/>
    </HBox>
</VBox>
