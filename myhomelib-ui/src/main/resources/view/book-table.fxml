<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.table.BookTableController"
      spacing="5" style="-fx-padding: 10;">

    <HBox spacing="7" alignment="CENTER_LEFT">
        <Button text="ui.fxml.book_table.filters" onAction="#openGlobalFilters"/>
        <Label fx:id="filterIndicatorLabel" text="ui.fxml.book_table.filter_off"/>
        <Separator orientation="VERTICAL"/>
        <Label text="ui.fxml.book_table.quick_filter"/>
        <ComboBox fx:id="quickFilterColumnComboBox" prefWidth="125"/>
        <TextField fx:id="quickFilterValueField" promptText="ui.fxml.book_table.enter_value" HBox.hgrow="ALWAYS"/>
        <Button text="ui.fxml.book_table.apply" onAction="#applyQuickFilter"/>
        <Button text="ui.fxml.book_table.value" accessibleText="ui.fxml.book_table.clear_quick_filter" onAction="#clearQuickFilter">
            <tooltip>
                <Tooltip text="ui.fxml.book_table.clear_quick_filter"/>
            </tooltip>
        </Button>
        <Button text="ui.fxml.book_table.columns" onAction="#showColumnChooser"/>
        <Button text="ui.fxml.book_table.reset_view" onAction="#resetTableProfile"/>
    </HBox>

    <TableView fx:id="bookTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="ui.fxml.book_table.title" prefWidth="250"/>
            <TableColumn fx:id="authorColumn" text="ui.fxml.book_table.author" prefWidth="150"/>
            <TableColumn fx:id="seriesColumn" text="ui.fxml.book_table.series" prefWidth="100"/>
            <TableColumn fx:id="genresColumn" text="ui.fxml.book_table.genres" prefWidth="100"/>
            <TableColumn fx:id="fileSizeColumn" text="ui.fxml.book_table.size" prefWidth="90"/>
            <TableColumn fx:id="rateColumn" text="ui.fxml.book_table.rating" prefWidth="80"/>
            <TableColumn fx:id="progressColumn" text="ui.fxml.book_table.progress" prefWidth="80"/>
            <TableColumn fx:id="activityColumn" text="ui.book.activity" prefWidth="140" sortable="false"/>
            <TableColumn fx:id="dateColumn" text="ui.fxml.book_table.added" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
        <Label text="ui.fxml.book_table.current"/>
        <Label fx:id="currentBookLabel" text="ui.fxml.book_table.value_925b09a"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="batchSelectionLabel" text="ui.fxml.book_table.batch_selected_0"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="ui.fxml.book_table.page_size"/>
        <ComboBox fx:id="pageSizeComboBox" prefWidth="70"/>
        <Button fx:id="prevPageButton" text="ui.fxml.book_table.value_e683eb5" accessibleText="ui.fxml.book_table.previous_page"/>
        <Label fx:id="pageInfoLabel" text="ui.fxml.book_table.page_1_of_1"/>
        <Button fx:id="nextPageButton" text="ui.fxml.book_table.value_60280e6" accessibleText="ui.fxml.book_table.next_page"/>
    </HBox>
</VBox>
