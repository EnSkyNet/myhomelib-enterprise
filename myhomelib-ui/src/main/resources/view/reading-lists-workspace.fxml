<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.readinglist.ReadingListsWorkspaceController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: -mhl-background;">
    <Label text="ui.reading_lists.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <SplitPane dividerPositions="0.28" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="6">
                <HBox spacing="5">
                    <Button text="ui.reading_lists.symbol_create" accessibleText="ui.reading_lists.create" onAction="#onCreate"/>
                    <Button text="ui.reading_lists.symbol_rename" accessibleText="ui.reading_lists.rename" onAction="#onRename"/>
                    <Button text="ui.reading_lists.symbol_delete" accessibleText="ui.reading_lists.delete" onAction="#onDelete"/>
                </HBox>
                <ListView fx:id="listsView" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox fx:id="detailsBox" spacing="8" visible="false" managed="false">
                <Label fx:id="listTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="listSummary"/>
                <HBox spacing="6">
                    <Button text="ui.reading_lists.add_selected" onAction="#onAddSelectedBook"/>
                    <Button text="ui.reading_lists.remove" onAction="#onRemove"/>
                    <Button text="ui.reading_lists.symbol_up" accessibleText="ui.reading_lists.move_up" onAction="#onMoveUp"/>
                    <Button text="ui.reading_lists.symbol_down" accessibleText="ui.reading_lists.move_down" onAction="#onMoveDown"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="ui.reading_lists.resume" onAction="#onResume"/>
                </HBox>
                <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="positionColumn" text="ui.reading_lists.position" prefWidth="55"/>
                        <TableColumn fx:id="titleColumn" text="ui.reading_lists.book" prefWidth="300"/>
                        <TableColumn fx:id="authorColumn" text="ui.reading_lists.author" prefWidth="220"/>
                        <TableColumn fx:id="seriesColumn" text="ui.reading_lists.series" prefWidth="180"/>
                        <TableColumn fx:id="progressColumn" text="ui.reading_lists.progress" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </items>
    </SplitPane>
</VBox>
