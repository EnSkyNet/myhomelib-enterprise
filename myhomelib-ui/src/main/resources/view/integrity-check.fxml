<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.controller.IntegrityCheckController"
      spacing="10" style="-fx-padding: 18; -fx-background-color: -mhl-background;"
      prefWidth="940" prefHeight="700">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="ui.fxml.integrity_check.library_health" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: -mhl-text;"/>
        <Label fx:id="overallStatusLabel" text="ui.fxml.integrity_check.health_has_not_been_checked_yet"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -mhl-muted-text;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="28" prefHeight="28"/>
        <Button fx:id="checkButton" text="ui.fxml.integrity_check.refresh_health" onAction="#onCheckIntegrity"/>
        <Button text="ui.fxml.integrity_check.safe_maintenance" onAction="#onSafeRepairInfo"/>
        <Button text="ui.fxml.integrity_check.export" onAction="#onExportReport"/>
        <Button text="ui.fxml.integrity_check.close" onAction="#closeDialog"/>
    </HBox>

    <Label fx:id="statusLabel" text="ui.fxml.integrity_check.ready_to_check" style="-fx-text-fill: -mhl-muted-text;"/>

    <VBox spacing="5" style="-fx-padding: 8; -fx-border-color: -mhl-border; -fx-border-radius: 4;">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="ui.fxml.integrity_check.full_text_index" style="-fx-font-weight: bold;"/>
            <Label fx:id="contentIndexValue" text="ui.fxml.integrity_check.value" style="-fx-font-weight: bold;"/>
            <Label fx:id="contentIndexDetailLabel" text="ui.fxml.integrity_check.loading_status" HBox.hgrow="ALWAYS"/>
            <Button text="ui.fxml.integrity_check.details" accessibleText="ui.fxml.integrity_check.full_text_index_details" onAction="#onShowContentIndex"/>
            <Button fx:id="contentIndexRebuildButton" text="ui.fxml.integrity_check.rebuild_contents" accessibleText="ui.fxml.integrity_check.rebuild_full_text_index" onAction="#onRebuildContentIndex"/>
            <Button fx:id="contentIndexCancelButton" text="ui.fxml.integrity_check.cancel" accessibleText="ui.fxml.integrity_check.cancel_full_text_index_rebuild" onAction="#onCancelContentIndexRebuild"/>
        </HBox>
        <ProgressBar fx:id="contentIndexProgress" maxWidth="Infinity" progress="0" visible="false" managed="false"/>
    </VBox>
    <Separator/>

    <GridPane hgap="8" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.28"/>
            <ColumnConstraints percentWidth="14.32"/>
        </columnConstraints>

        <VBox GridPane.columnIndex="0" spacing="3" style="-fx-padding: 10; -fx-border-color: -mhl-border; -fx-border-radius: 4;">
            <Label text="ui.fxml.integrity_check.local_files" style="-fx-text-fill: -mhl-muted-text;"/>
            <Label fx:id="localArtifactsValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
        <Button GridPane.columnIndex="1" accessibleText="ui.fxml.integrity_check.missing" onAction="#onShowMissing" maxWidth="Infinity" minHeight="62">
            <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.missing"/><Label fx:id="missingValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></VBox></graphic>
        </Button>
        <Button GridPane.columnIndex="2" accessibleText="ui.fxml.integrity_check.corrupt" onAction="#onShowCorrupt" maxWidth="Infinity" minHeight="62">
            <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.corrupt"/><Label fx:id="corruptValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></VBox></graphic>
        </Button>
        <Button GridPane.columnIndex="3" accessibleText="ui.fxml.integrity_check.changed" onAction="#onShowChanged" maxWidth="Infinity" minHeight="62">
            <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.changed"/><Label fx:id="changedValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></VBox></graphic>
        </Button>
        <Button GridPane.columnIndex="4" accessibleText="ui.fxml.integrity_check.duplicates" onAction="#onShowDuplicates" maxWidth="Infinity" minHeight="62">
            <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.duplicates"/><Label fx:id="duplicatesValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></VBox></graphic>
        </Button>
        <Button GridPane.columnIndex="5" accessibleText="ui.fxml.integrity_check.metadata_gaps" onAction="#onShowMetadata" maxWidth="Infinity" minHeight="62">
            <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.metadata_gaps"/><Label fx:id="metadataValue" text="ui.fxml.integrity_check.value" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></VBox></graphic>
        </Button>
        <VBox GridPane.columnIndex="6" spacing="4">
            <Button accessibleText="ui.fxml.integrity_check.search_index" onAction="#onShowIndex" maxWidth="Infinity">
                <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.search_index"/><Label fx:id="indexValue" text="ui.fxml.integrity_check.value" style="-fx-font-weight: bold;"/></VBox></graphic>
            </Button>
            <Button accessibleText="ui.fxml.integrity_check.backup_age" onAction="#onShowBackup" maxWidth="Infinity">
                <graphic><VBox alignment="CENTER"><Label text="ui.fxml.integrity_check.backup_age"/><Label fx:id="backupValue" text="ui.fxml.integrity_check.value" style="-fx-font-weight: bold;"/></VBox></graphic>
            </Button>
        </VBox>
    </GridPane>

    <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="6">
                <Label text="ui.fxml.integrity_check.issues_and_recommended_actions" style="-fx-font-weight: bold;"/>
                <TableView fx:id="issueTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="severityColumn" text="ui.fxml.integrity_check.level" prefWidth="85"/>
                        <TableColumn fx:id="categoryColumn" text="ui.fxml.integrity_check.category" prefWidth="190"/>
                        <TableColumn fx:id="countColumn" text="ui.fxml.integrity_check.count" prefWidth="65"/>
                        <TableColumn fx:id="actionColumn" text="ui.fxml.integrity_check.action" prefWidth="310"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox spacing="6">
                <Label text="ui.fxml.integrity_check.check_details" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="detailArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          style="-fx-font-family: 'Consolas', 'Monaco', monospace; -fx-font-size: 12px;"/>
            </VBox>
        </items>
    </SplitPane>

    <Label text="ui.fxml.integrity_check.the_check_does_not_perform_automatic_unsafe_ca0b059"
           wrapText="true" style="-fx-text-fill: -mhl-muted-text; -fx-font-size: 11px;"/>
</VBox>
