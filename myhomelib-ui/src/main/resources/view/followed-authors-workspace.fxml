<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.myhomelibcorp.ui.following.FollowedAuthorsWorkspaceController">
    <top>
        <VBox spacing="8" BorderPane.alignment="CENTER">
            <padding><Insets top="14" right="16" bottom="10" left="16"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="ui.fxml.followed_authors_workspace.author_tracking" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24" visible="false" managed="false"/>
                <Button fx:id="refreshButton" text="ui.fxml.followed_authors_workspace.refresh" onAction="#refresh"/>
            </HBox>
            <Label fx:id="summaryLabel" text="ui.fxml.followed_authors_workspace.author_tracking"/>
            <Separator/>
        </VBox>
    </top>
    <center>
        <StackPane>
            <padding><Insets right="16" bottom="10" left="16"/></padding>
            <TableView fx:id="followedTable">
                <columns>
                    <TableColumn fx:id="authorColumn" text="ui.fxml.followed_authors_workspace.author" prefWidth="260"/>
                    <TableColumn fx:id="booksColumn" text="ui.fxml.followed_authors_workspace.books" prefWidth="80"/>
                    <TableColumn fx:id="newColumn" text="ui.fxml.followed_authors_workspace.new" prefWidth="80"/>
                    <TableColumn fx:id="lastBookColumn" text="ui.fxml.followed_authors_workspace.latest_book" prefWidth="320"/>
                    <TableColumn fx:id="dateColumn" text="ui.fxml.followed_authors_workspace.date" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="emptyLabel" text="ui.fxml.followed_authors_workspace.you_are_not_following_any_authors_yet"
                   visible="false" managed="false" style="-fx-font-size: 15px; -fx-opacity: 0.75;"/>
        </StackPane>
    </center>
    <bottom>
        <VBox spacing="8">
            <padding><Insets top="8" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="detailLabel" text="ui.fxml.followed_authors_workspace.select_an_author" wrapText="true"/>
            <HBox spacing="8">
                <Button fx:id="openAuthorButton" text="ui.fxml.followed_authors_workspace.open_author" onAction="#openAuthor"/>
                <Button text="ui.fxml.followed_authors_workspace.view_updates" onAction="#openUpdates"/>
                <Button fx:id="acknowledgeButton" text="ui.fxml.followed_authors_workspace.mark_updates_as_viewed" onAction="#acknowledgeAuthor"/>
                <Button fx:id="unfollowButton" text="ui.fxml.followed_authors_workspace.unfollow" onAction="#unfollowAuthor"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
