<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.Region?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.statusbar.StatusBarController"
      style="-fx-background-color: -mhl-border; -fx-border-color: -mhl-border; -fx-border-width: 1 0 0 0;"
      spacing="10" alignment="CENTER_LEFT" prefHeight="30">

    <padding><Insets bottom="4" left="10" right="10" top="4"/></padding>

    <Label fx:id="statusLabel" text="ui.fxml.statusbar.ready" HBox.hgrow="ALWAYS"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="operationsLabel" text="ui.fxml.statusbar.operations_0" onMouseClicked="#onOperationsClick" style="-fx-cursor: hand;"/>
    <Label fx:id="statsLabel" text="ui.fxml.statusbar.books_0_authors_0_series_0_index_database_ram_0_mb"/>
    <ProgressBar fx:id="progressBar" visible="false" prefWidth="150"/>
</HBox>