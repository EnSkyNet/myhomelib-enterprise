<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.controller.BackupController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: -mhl-background;"
      prefWidth="620" prefHeight="520">

    <Label text="ui.fxml.backup_dialog.backup" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -mhl-text;"/>

    <Separator/>

    <!-- Шлях для резервної копії -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="ui.fxml.backup_dialog.backup_destination" prefWidth="120" style="-fx-font-weight: bold;"/>
        <TextField fx:id="backupPathField" HBox.hgrow="ALWAYS" promptText="ui.fxml.backup_dialog.choose_a_folder"/>
        <Button fx:id="selectPathButton" text="ui.fxml.backup_dialog.choose" onAction="#onSelectPath"
                style="-fx-background-color: -mhl-accent; -fx-text-fill: -mhl-on-accent;"/>
    </HBox>

    <Separator/>

    <!-- Опції резервного копіювання -->
    <Label text="ui.fxml.backup_dialog.backup_contents" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: -mhl-panel; -fx-border-color: -mhl-border; -fx-border-radius: 5;">
        <CheckBox fx:id="includeMetadataCheckBox" text="ui.fxml.backup_dialog.versioned_user_data_libid" selected="true"/>
        <Label text="ui.fxml.backup_dialog.portable_user_data_json_contains_ratings_rea_4bba17a" wrapText="true" style="-fx-text-fill: -mhl-muted-text; -fx-font-style: italic;"/>
        <Label text="ui.fxml.backup_dialog.a_consistent_sqlite_database_snapshot_is_alw_c6615a3" wrapText="true" style="-fx-text-fill: -mhl-muted-text; -fx-font-style: italic;"/>
    </VBox>

    <Separator/>

    <!-- Прогрес -->
    <VBox spacing="5">
        <Label fx:id="statusLabel" text="ui.fxml.backup_dialog.ready_to_back_up" style="-fx-text-fill: -mhl-muted-text;"/>
        <ProgressBar fx:id="progressBar" prefWidth="580" visible="false"/>
    </VBox>

    <!-- Лог -->
    <TextArea fx:id="logArea" prefHeight="150" editable="false" visible="false"
              style="-fx-font-family: monospace; -fx-font-size: 12px; -fx-background-color: -mhl-code-background; -fx-text-fill: -mhl-code-text;"/>

    <!-- Кнопки -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="backupButton" text="ui.fxml.backup_dialog.create_backup" onAction="#onBackup"
                style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent; -fx-font-weight: bold; -fx-padding: 8 25;"/>
        <Button text="ui.fxml.backup_dialog.close" onAction="#onClose"
                style="-fx-background-color: -mhl-muted-text; -fx-text-fill: -mhl-on-accent;"/>
    </HBox>

</VBox>