<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.imports.ImportWorkspaceController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">

    <Label text="📂 Імпорт бібліотеки" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Виберіть папку або файл для імпорту:"/>

    <HBox spacing="5">
        <TextField fx:id="pathField" promptText="D:\Books" HBox.hgrow="ALWAYS"/>
        <Button fx:id="selectButton" text="📁 Папка" onAction="#onSelectDirectory"/>
        <Button fx:id="selectButton" text="📄 Файл" onAction="#onSelectFile"/>
        <Button fx:id="clearButton" text="✕" onAction="#onClear"/>
    </HBox>

    <GridPane hgap="20" vgap="5">
        <Label text="Знайдено книг:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="foundBooksLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Нових:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <Label fx:id="newBooksLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Дублікатів:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="duplicatesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Помилок:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
        <Label fx:id="errorsLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <ProgressBar fx:id="progressBar" prefWidth="Double.MAX_VALUE" progress="0"/>

    <Label fx:id="currentFileLabel" text=""/>
    <Label fx:id="statusLabel" text="Готово до імпорту" style="-fx-font-style: italic;"/>

    <HBox spacing="10">
        <Button fx:id="startButton" text="▶ Старт" onAction="#onStartImport" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button fx:id="pauseButton" text="⏸ Пауза" onAction="#onPause" disable="true"/>
        <Button fx:id="cancelButton" text="⏹ Скасувати" onAction="#onCancel" disable="true" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>
</VBox>