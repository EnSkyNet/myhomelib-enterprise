<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.imports.ImportWorkspaceController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">

    <Label text="📂 Імпорт бібліотеки" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Папка:"/>
        <TextField fx:id="directoryField" promptText="Виберіть папку з книгами" HBox.hgrow="ALWAYS"/>
        <Button text="Обрати..." onAction="#onChooseDirectory"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Файл:"/>
        <TextField fx:id="fileField" promptText="Виберіть файл (FB2, INPX...)" HBox.hgrow="ALWAYS"/>
        <Button text="Обрати..." onAction="#onChooseFile"/>
    </HBox>

    <Separator/>

    <HBox spacing="10">
        <Button text="Імпортувати папку" onAction="#onImportDirectory" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Імпортувати файл" onAction="#onImportFile" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button fx:id="cancelButton" text="Скасувати" onAction="#onCancel" disable="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Налаштування" onAction="#onSettings"/>
    </HBox>

    <Separator/>

    <VBox spacing="5">
        <Label text="Статус:" style="-fx-font-weight: bold;"/>
        <Label fx:id="statusLabel" text="Готово до імпорту"/>
        <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0"/>
        <Label fx:id="progressLabel" text="0%"/>
    </VBox>

    <Separator/>

    <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;">
        <Label text="📊 Статистика імпорту" style="-fx-font-weight: bold;"/>
        <GridPane hgap="10.0" vgap="5.0">
            <Label text="Знайдено файлів:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <Label fx:id="foundFilesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Імпортовано книг:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
            <Label fx:id="importedBooksLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Помилок:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <Label fx:id="errorsLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </VBox>
</VBox>