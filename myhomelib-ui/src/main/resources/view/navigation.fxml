<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:id="navigationContainer"
      fx:controller="com.myhomelibcorp.ui.navigation.NavigationController"
      spacing="2"
      style="-fx-padding: 5; -fx-background-color: #f5f5f5;"
      maxWidth="1.7976931348623157E308">

    <!-- ========== АЛФАВІТНА ПАНЕЛЬ (додано) ========== -->
    <HBox fx:id="alphabetToolbarContainer"
          style="-fx-padding: 0 0 5 0; -fx-min-height: 40;"
          maxWidth="1.7976931348623157E308"/>

    <!-- ========== ПОШУК АВТОРІВ (додано) ========== -->
    <TextField fx:id="authorSearchField"
               promptText="🔍 Пошук авторів..."
               style="-fx-padding: 5; -fx-background-radius: 4; -fx-border-radius: 4;"/>

    <Separator/>

    <!-- ========== ГОЛОВНЕ МЕНЮ ========== -->
    <Button text="🏠 Головна" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onHome" maxWidth="1.7976931348623157E308"/>
    <Button text="📚 Автори" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onAuthors" maxWidth="1.7976931348623157E308"/>
    <Button text="📖 Серії" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onSeries" maxWidth="1.7976931348623157E308"/>
    <Button text="🏷 Жанри" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onGenres" maxWidth="1.7976931348623157E308"/>
    <Button text="⭐ Колекції" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onCollections" maxWidth="1.7976931348623157E308"/>
    <Button text="📁 Групи" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onGroups" maxWidth="1.7976931348623157E308"/>
    <Separator/>

    <Button text="🔥 Нові книги" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onNewBooks" maxWidth="1.7976931348623157E308"/>
    <Button text="🕓 Історія" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onHistory" maxWidth="1.7976931348623157E308"/>

    <Separator/>

    <Button text="🔍 Пошук" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onSearch" maxWidth="1.7976931348623157E308"/>
    <Button text="📂 Імпорт" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onImport" maxWidth="1.7976931348623157E308"/>
    <Button text="⚙ Налаштування" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;"
            onAction="#onSettings" maxWidth="1.7976931348623157E308"/>

    <Separator/>

    <!-- ========== ДЕРЕВО НАВІГАЦІЇ ========== -->
    <TreeView fx:id="navigationTree" VBox.vgrow="ALWAYS"
              style="-fx-background-color: transparent; -fx-padding: 0;"/>
</VBox>