<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.navigation.NavigationController"
      spacing="2" style="-fx-padding: 5; -fx-background-color: #f5f5f5;">

    <!-- Головне меню -->
    <Button text="🏠 Головна" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onHome"/>
    <Button text="📚 Автори" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onAuthors"/>
    <Button text="📖 Серії" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onSeries"/>
    <Button text="🏷 Жанри" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onGenres"/>
    <Button text="⭐ Колекції" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onCollections"/>
    <Button text="Групи" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onGroups"/>
    <Separator/>

    <Button text="📥 Нові книги" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onNewBooks"/>
    <Button text="🕓 Історія" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onHistory"/>

    <Separator/>

    <Button text="🔍 Пошук" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onSearch"/>
    <Button text="📂 Імпорт" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onImport"/>
    <Button text="⚙ Налаштування" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 8 10;" onAction="#onSettings"/>

    <Separator/>

    <!-- Дерево для категорій (Автори, Серії, Жанри) можна залишити як додатковий елемент -->
    <TreeView fx:id="navigationTree" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-padding: 0;"/>
</VBox>