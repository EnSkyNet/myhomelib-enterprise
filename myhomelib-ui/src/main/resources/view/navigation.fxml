<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.navigation.NavigationController"
      spacing="2" style="-fx-padding: 5; -fx-background-color: #f5f5f5;">

    <Label text="📚 Бібліотека" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 5 0 5 0;"/>

    <TreeView fx:id="navigationTree" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;"/>

    <Separator/>

    <VBox spacing="2">
        <Button text="⭐ Останні відкриті" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onRecentOpened"/>
        <Button text="❤️ Обране" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onFavorites"/>
        <Button text="📖 Продовжити читання" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onContinueReading"/>
    </VBox>

    <Separator/>

    <VBox spacing="2">
        <Button text="👤 Автори" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onAuthors"/>
        <Button text="📚 Серії" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onSeries"/>
        <Button text="🏷 Жанри" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onGenres"/>
        <Button text="🌍 Мови" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onLanguages"/>
        <Button text="📅 Роки" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onYears"/>
        <Button text="🏢 Видавництва" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onPublishers"/>
        <Button text="📂 Колекції" style="-fx-background-color: transparent; -fx-alignment: center-left;" onAction="#onCollections"/>
    </VBox>
</VBox>