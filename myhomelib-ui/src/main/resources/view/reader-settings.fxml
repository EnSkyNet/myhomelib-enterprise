<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.reader.ReaderSettingsController"
      spacing="10"
      style="-fx-padding: 20; -fx-background-color: #f5f5f5; -fx-text-fill: #333333;"
      prefWidth="540" prefHeight="580">

    <Label text="⚙️ Налаштування Reader"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator style="-fx-background-color: #d0d0d0;"/>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #f5f5f5; -fx-background-color: #f5f5f5; -fx-border-color: transparent; -fx-padding: 0;">
        <content>
            <VBox spacing="15" style="-fx-padding: 5 10 5 10; -fx-background-color: #f5f5f5;">

                <TabPane style="-fx-background-color: #ffffff; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <!-- Вкладка Текст -->
                    <Tab text="📝 Текст" style="-fx-text-fill: #333333;">
                        <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff;">
                            <Label text="Шрифт:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <ComboBox fx:id="fontFamilyCombo" prefWidth="200"
                                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 3;"/>

                            <Label text="Розмір шрифту:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="fontSizeSlider" min="10" max="40" value="18"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="5" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Міжрядковий інтервал:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="lineSpacingSlider" min="1.0" max="3.0" value="1.6"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="0.5" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Відступ абзацу:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="firstLineIndentSlider" min="0" max="3" value="1.5"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="0.5" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Ширина тексту:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <ComboBox fx:id="widthModeCombo" prefWidth="200"
                                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 3;"/>

                            <CheckBox fx:id="hyphenationCheck" text="Переноси слів"
                                      style="-fx-text-fill: #333333;"/>
                            <CheckBox fx:id="autoScrollCheck" text="Автоскрол"
                                      style="-fx-text-fill: #333333;"/>
                        </VBox>
                    </Tab>

                    <!-- Вкладка Тема та стиль -->
                    <Tab text="🎨 Тема та стиль" style="-fx-text-fill: #333333;">
                        <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff;">
                            <Label text="Тема оформлення:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <ComboBox fx:id="themeCombo" prefWidth="200"
                                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 3;"/>

                            <CheckBox fx:id="pageModeCheck" text="Режим сторінок"
                                      style="-fx-text-fill: #333333;"/>

                            <Label text="Користувацькі CSS:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <TextArea fx:id="customCssArea" prefHeight="100"
                                      promptText="Введіть свої CSS стилі..."
                                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 3; -fx-text-fill: #333333;"/>
                        </VBox>
                    </Tab>

                    <!-- Вкладка Відступи -->
                    <Tab text="📐 Відступи" style="-fx-text-fill: #333333;">
                        <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff;">
                            <Label text="Верхній відступ:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="marginTopSlider" min="0" max="80" value="20"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="20" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Нижній відступ:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="marginBottomSlider" min="0" max="80" value="20"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="20" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Лівий відступ:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="marginLeftSlider" min="0" max="100" value="30"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="20" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>

                            <Label text="Правий відступ:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                            <Slider fx:id="marginRightSlider" min="0" max="100" value="30"
                                    showTickLabels="true" showTickMarks="true"
                                    majorTickUnit="20" minorTickCount="4"
                                    style="-fx-text-fill: #333333;"/>
                        </VBox>
                    </Tab>
                </TabPane>

            </VBox>
        </content>
    </ScrollPane>

    <Separator style="-fx-background-color: #d0d0d0;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="🔄 Скинути" onAction="#onReset"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 4;"/>
        <Button text="💾 Зберегти" onAction="#onSave"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 4;"/>
        <Button text="❌ Скасувати" onAction="#onCancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 4;"/>
    </HBox>
</VBox>