<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.myhomelibcorp.ui.details.BookDetailsController"
            fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
            style="-fx-background-color: transparent; -fx-background: -mhl-panel;">
    <content>
        <VBox spacing="8" style="-fx-padding: 10; -fx-background-color: -mhl-panel;">
            <VBox alignment="CENTER" style="-fx-padding: 6;">
                <ImageView fx:id="coverImageView" fitWidth="180" fitHeight="250" preserveRatio="true"
                           style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 12, 0, 0, 4);"/>
            </VBox>
            <Label fx:id="titleLabel" text="ui.fxml.details.title" wrapText="true"
                   style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            <Label fx:id="documentWarningLabel" wrapText="true" visible="false" managed="false"
                   style="-fx-text-fill: -mhl-warning-text; -fx-background-color: -mhl-warning-bg; -fx-padding: 6;"/>
            <Button fx:id="downloadBookButton" text="ui.book_details.download" onAction="#onDownloadBook"
                    visible="false" managed="false" disable="true"/>

            <TitledPane text="ui.details.section.main" expanded="true" animated="false">
                <content>
                    <VBox spacing="6" style="-fx-padding: 8;">
                        <Label text="ui.fxml.details.authors" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="authorsLinksPane" hgap="6" vgap="3"/>
                        <Label text="ui.fxml.details.series" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="seriesLinksPane" hgap="6" vgap="3"/>
                        <Label text="ui.fxml.details.genres" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="genresLinksPane" hgap="6" vgap="3"/>
                        <Label text="ui.fxml.details.book_annotation" style="-fx-font-weight: bold;"/>
                        <Label fx:id="annotationLabel" wrapText="true" maxWidth="1.7976931348623157E308"/>
                        <Separator/>
                        <Label fx:id="languageLabel" text="ui.fxml.details.language" wrapText="true"/>
                        <Label fx:id="sourceLanguageLabel" text="ui.fxml.details.original_language" wrapText="true"/>
                        <Label fx:id="yearLabel" text="ui.fxml.details.year"/>
                        <Hyperlink fx:id="publisherLink" text="ui.fxml.details.publisher" wrapText="true"/>
                        <Label fx:id="isbnLabel" text="ui.fxml.details.isbn" wrapText="true"/>
                        <Label fx:id="translatorsLabel" text="ui.fxml.details.translators" wrapText="true"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="ui.details.section.reading" expanded="true" animated="false">
                <content>
                    <VBox spacing="6" style="-fx-padding: 8;">
                        <Label fx:id="localStatusLabel" text="ui.fxml.details.status"/>
                        <Label fx:id="ratingLabel" text="ui.fxml.details.rating"/>
                        <Label fx:id="progressLabel" text="ui.fxml.details.read"/>
                        <Label fx:id="libraryRateLabel" text="ui.fxml.details.catalog_rating"/>
                        <Label text="ui.fxml.details.quick_links" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="reviewLinksPane" hgap="6" vgap="4"/>
                        <Label text="ui.fxml.details.my_review" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="reviewArea" wrapText="true" prefHeight="90" editable="false"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="ui.details.section.files" expanded="false" animated="false">
                <content>
                    <VBox spacing="6" style="-fx-padding: 8;">
                        <Label fx:id="formatLabel" text="ui.fxml.details.format"/>
                        <Label fx:id="fileSizeLabel" text="ui.fxml.details.file_size"/>
                        <Label text="ui.fxml.details.available_formats" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="artifactBadgesPane" hgap="5" vgap="4"/>
                        <ComboBox fx:id="artifactComboBox" maxWidth="1.7976931348623157E308" promptText="ui.fxml.details.select_format"/>
                        <Label fx:id="artifactLocationLabel" text="ui.fxml.details.source_location" wrapText="true" styleClass="muted-text"/>
                        <HBox spacing="6">
                            <Button fx:id="setPreferredArtifactButton" text="ui.fxml.details.make_primary" onAction="#onSetPreferredArtifact" disable="true"/>
                            <Button fx:id="openArtifactButton" text="ui.fxml.details.open_as" onAction="#onOpenSelectedArtifact" disable="true"/>
                        </HBox>
                        <Separator/>
                        <Label fx:id="textStatsLabel" text="ui.fxml.details.text" wrapText="true"/>
                        <Label fx:id="imagesCountLabel" text="ui.fxml.details.images_0"/>
                        <Button fx:id="showImagesButton" text="ui.fxml.details.view_images" onAction="#onShowImages"
                                visible="false" managed="false"/>
                        <Button fx:id="scanDuplicatePagesButton" text="ui.comic.duplicates.action" onAction="#onScanDuplicatePages"
                                visible="false" managed="false"/>
                        <Label text="ui.fxml.details.table_of_contents" style="-fx-font-weight: bold;"/>
                        <VBox fx:id="tocPreviewBox" spacing="2"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="ui.details.section.library" expanded="false" animated="false">
                <content>
                    <VBox spacing="6" style="-fx-padding: 8;">
                        <Label text="ui.fxml.details.groups" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="groupLinksPane" hgap="6" vgap="4"/>
                        <Label text="ui.fxml.details.keywords" style="-fx-font-weight: bold;"/>
                        <FlowPane fx:id="keywordsLinksPane" hgap="6" vgap="4"/>
                        <Separator/>
                        <Label text="ui.details.similar_books" style="-fx-font-weight: bold;"/>
                        <VBox fx:id="similarBooksBox" spacing="3"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="ui.details.section.technical" expanded="false" animated="false">
                <content>
                    <VBox spacing="6" style="-fx-padding: 8;">
                        <Label text="ui.fxml.details.source" style="-fx-font-weight: bold;"/>
                        <Label fx:id="sourceUrlLabel" text="ui.fxml.details.source_da86429" wrapText="true"/>
                    </VBox>
                </content>
            </TitledPane>

            <HBox spacing="8" style="-fx-padding: 8 0 6 0;">
                <Button text="ui.fxml.details.read_1b059c1" onAction="#onRead"
                        style="-fx-background-color: -mhl-success; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="ui.fxml.details.edit" onAction="#onEdit"
                        style="-fx-background-color: -mhl-accent; -fx-text-fill: -mhl-on-accent;"/>
                <Button text="ui.fxml.details.folder" onAction="#onOpenFolder"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
