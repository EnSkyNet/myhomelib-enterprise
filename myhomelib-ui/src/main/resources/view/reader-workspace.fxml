<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.reader.ReaderWorkspaceController"
      spacing="0"
      style="-fx-background-color: #f5f5f5;"
      VBox.vgrow="ALWAYS"
      prefHeight="0"
      minHeight="0">

    <!-- ToolBar -->
    <ToolBar style="-fx-background-color: #e0e0e0; -fx-padding: 5;">
        <Button text="← Назад" onAction="#onBack" style="-fx-font-weight: bold;"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Книга:"/>
        <Label fx:id="bookTitleLabel" text="Назва" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🔍" onAction="#onToggleSearch">
            <tooltip><Tooltip text="Пошук (Ctrl+F)"/></tooltip>
        </Button>
        <Button text="🔍+" onAction="#onZoomIn">
            <tooltip><Tooltip text="Збільшити"/></tooltip>
        </Button>
        <Button text="🔍-" onAction="#onZoomOut">
            <tooltip><Tooltip text="Зменшити"/></tooltip>
        </Button>
        <Button text="100%" onAction="#onZoomReset">
            <tooltip><Tooltip text="Скинути масштаб"/></tooltip>
        </Button>
        <Button text="🌙" onAction="#onToggleTheme">
            <tooltip><Tooltip text="Тема (світла/темна)"/></tooltip>
        </Button>
        <Button text="📑" onAction="#onToggleToc">
            <tooltip><Tooltip text="Зміст"/></tooltip>
        </Button>
        <Button text="⭐" onAction="#onAddBookmark">
            <tooltip><Tooltip text="Додати закладку"/></tooltip>
        </Button>
        <Button text="⭐" onAction="#onOpenBookmarks">
            <tooltip><Tooltip text="Закладки"/></tooltip>
        </Button>
        <Button text="⚙" onAction="#onShowSettings">
            <tooltip><Tooltip text="Налаштування"/></tooltip>
        </Button>
    </ToolBar>

    <!-- Пошукова панель -->
    <HBox fx:id="searchBar" spacing="5" alignment="CENTER_LEFT"
          style="-fx-background-color: #f0f0f0; -fx-padding: 5 10; -fx-border-color: #ccc; -fx-border-width: 0 0 1 0;"
          visible="false" managed="false">
        <Label text="Пошук:"/>
        <TextField fx:id="searchField" promptText="Введіть текст..." HBox.hgrow="ALWAYS"
                   onAction="#onSearchFieldAction"/>
        <Label fx:id="searchStatus" text="0/0" style="-fx-font-weight: bold; -fx-min-width: 40;"/>
        <Button text="↑" onAction="#onSearchPrev" style="-fx-font-size: 12px;">
            <tooltip><Tooltip text="Попередній збіг (Shift+Ctrl+G)"/></tooltip>
        </Button>
        <Button text="↓" onAction="#onSearchNext" style="-fx-font-size: 12px;">
            <tooltip><Tooltip text="Наступний збіг (Ctrl+G)"/></tooltip>
        </Button>
        <Button text="✕" onAction="#onSearchClose">
            <tooltip><Tooltip text="Закрити пошук (Escape)"/></tooltip>
        </Button>
    </HBox>

    <!-- WebView контейнер -->
    <StackPane fx:id="webViewContainer"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: #ffffff;">
    </StackPane>

    <!-- Нижня панель -->
    <HBox style="-fx-background-color: #e0e0e0; -fx-padding: 5;" spacing="10" alignment="CENTER_LEFT"
          prefHeight="30" minHeight="30" maxHeight="30">
        <ProgressBar fx:id="progressBar" prefWidth="200" progress="0"/>
        <Label fx:id="progressLabel" text="0%"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="bookmarksLabel" text="⭐ 0"/>
    </HBox>
</VBox>