<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.navigation.NavigationPanelController"
      spacing="5"
      style="-fx-padding: 5; -fx-background-color: -mhl-background; -fx-pref-width: 250; -fx-max-width: 300;"
      VBox.vgrow="ALWAYS">

    <Label fx:id="navigationTitleLabel" text="ui.fxml.navigation_panel.navigation" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <!-- Scalable mode selector: stage 3+ can add modes without redesigning the panel. -->
    <ComboBox fx:id="navigationModeComboBox"
              maxWidth="1.7976931348623157E308"
              promptText="ui.fxml.navigation_panel.navigation_mode"/>

    <Separator/>

    <HBox fx:id="navigationSearchRow" spacing="4">
        <TextField fx:id="listSearchField" promptText="ui.fxml.navigation_panel.search"
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 4; -fx-border-radius: 4;"/>
        <Button text="ui.fxml.navigation_panel.value" accessibleText="ui.fxml.navigation_panel.clear_navigation_search" onAction="#onClearListSearch">
            <tooltip><Tooltip text="ui.fxml.navigation_panel.clear_search"/></tooltip>
        </Button>
    </HBox>

    <!-- Updates use four independently labelled dropdowns instead of a flat list.
         The selected period opens the existing date-filtered book search. -->
    <VBox fx:id="updatesPeriodPanel" spacing="9" visible="false" managed="false">
        <Label text="Оновлення за день"/>
        <ComboBox fx:id="updatesDayComboBox" promptText="Виберіть 1–6 днів"
                  maxWidth="1.7976931348623157E308"/>
        <Label text="Оновлення за тиждень"/>
        <ComboBox fx:id="updatesWeekComboBox" promptText="Виберіть 1–4 тижні"
                  maxWidth="1.7976931348623157E308"/>
        <Label text="Оновлення за місяць"/>
        <ComboBox fx:id="updatesMonthComboBox" promptText="Виберіть місяць і рік"
                  maxWidth="1.7976931348623157E308"/>
        <Label text="Оновлення за рік"/>
        <ComboBox fx:id="updatesYearComboBox" promptText="Виберіть рік"
                  maxWidth="1.7976931348623157E308"/>
        <Separator/>
        <Button text="Сповіщення каталогу" onAction="#onOpenCatalogUpdates"
                maxWidth="1.7976931348623157E308"/>
    </VBox>

    <ListView fx:id="navigationListView" VBox.vgrow="ALWAYS"/>
    <Button fx:id="loadMoreAuthorsButton"
            text="ui.fxml.navigation_panel.load_more"
            onAction="#onLoadMoreAuthors"
            maxWidth="1.7976931348623157E308"
            visible="false" managed="false"/>
</VBox>
