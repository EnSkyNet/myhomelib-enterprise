<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.navigation.NavigationPanelController"
      spacing="5"
      style="-fx-padding: 5; -fx-background-color: -mhl-background; -fx-pref-width: 250; -fx-max-width: 300;"
      VBox.vgrow="ALWAYS">

    <Label fx:id="navigationTitleLabel" text="Навігація" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <!-- Scalable mode selector: stage 3+ can add modes without redesigning the panel. -->
    <ComboBox fx:id="navigationModeComboBox"
              maxWidth="1.7976931348623157E308"
              promptText="Режим навігації"/>

    <Separator/>

    <HBox spacing="4">
        <TextField fx:id="listSearchField" promptText="🔍 Пошук..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 4; -fx-border-radius: 4;"/>
        <Button text="✕" onAction="#onClearListSearch" focusTraversable="false">
            <tooltip><Tooltip text="Очистити пошук"/></tooltip>
        </Button>
    </HBox>

    <ListView fx:id="navigationListView" VBox.vgrow="ALWAYS"/>
    <Button fx:id="loadMoreAuthorsButton"
            text="Завантажити ще"
            onAction="#onLoadMoreAuthors"
            maxWidth="1.7976931348623157E308"
            visible="false" managed="false"/>
</VBox>
