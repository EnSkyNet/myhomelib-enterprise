<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.search.SearchWorkspaceController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Пошук" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Введіть назву, автора, серію..." prefWidth="300"/>
        <Button text="Знайти" onAction="#onSearch" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="✕" onAction="#onClear"/>
    </HBox>

    <Label fx:id="statusLabel" text="Введіть запит для пошуку" style="-fx-font-style: italic; -fx-text-fill: #666;"/>

    <Separator/>

    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <!-- Автори -->
        <VBox fx:id="authorsSection" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;">
            <HBox spacing="5">
                <Label text="Автори" style="-fx-font-weight: bold;"/>
                <Label fx:id="authorsCountLabel" text="(0)"/>
            </HBox>
            <ListView fx:id="authorsListView" prefHeight="120"/>
        </VBox>

        <!-- Серії -->
        <VBox fx:id="seriesSection" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;">
            <HBox spacing="5">
                <Label text="Серії" style="-fx-font-weight: bold;"/>
                <Label fx:id="seriesCountLabel" text="(0)"/>
            </HBox>
            <ListView fx:id="seriesListView" prefHeight="120"/>
        </VBox>

        <!-- Жанри -->
        <VBox fx:id="genresSection" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;">
            <HBox spacing="5">
                <Label text="Жанри" style="-fx-font-weight: bold;"/>
                <Label fx:id="genresCountLabel" text="(0)"/>
            </HBox>
            <ListView fx:id="genresListView" prefHeight="120"/>
        </VBox>

        <!-- Книги -->
        <VBox fx:id="booksSection" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
            <HBox spacing="5">
                <Label text="Книги" style="-fx-font-weight: bold;"/>
                <Label fx:id="booksCountLabel" text="(0)"/>
            </HBox>
            <ListView fx:id="booksListView" prefHeight="300" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>
</VBox>