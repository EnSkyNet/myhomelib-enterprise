<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.search.SearchWorkspaceController"
      spacing="10" style="-fx-padding: 12; -fx-background-color: -mhl-background;">

    <Label text="🔎 Пошук у бібліотеці" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="8">
        <TextField fx:id="searchField" promptText="Назва, автор, серія, жанр..." HBox.hgrow="ALWAYS" onAction="#onSearch"/>
        <Button text="Шукати" onAction="#onSearch" defaultButton="true"/>
        <Button text="Очистити" onAction="#onClear"/>
        <Button text="Фільтри…" onAction="#onGlobalFilters"/>
        <Label fx:id="filterIndicatorLabel" text="Фільтр вимкнено"/>
        <Button fx:id="saveSearchButton" text="💾 Зберегти"/>
        <Button fx:id="savedSearchesButton" text="📂 Збережені"/>
    </HBox>

    <TitledPane text="Розширений пошук (як у класичному MyHomeLib)" expanded="false">
        <content>
            <VBox spacing="8" style="-fx-padding: 10;">
                <GridPane hgap="8" vgap="8">
                    <Label text="Назва" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="titleFilter" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Автор" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="authorFilter" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Серія" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="seriesFilter" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Жанр" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="genreFilter" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <Label text="Ключові слова" GridPane.columnIndex="0" GridPane.rowIndex="2"/><TextField fx:id="keywordFilter" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Анотація" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextField fx:id="annotationFilter" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    <Label text="Ім'я файлу" GridPane.columnIndex="0" GridPane.rowIndex="3"/><TextField fx:id="fileFilter" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Мова" GridPane.columnIndex="2" GridPane.rowIndex="3"/><TextField fx:id="languageFilter" promptText="uk, en..." GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                    <Label text="Оцінка бібліотеки від/до" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <HBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4"><TextField fx:id="ratingFromFilter" prefWidth="55"/><Label text="—"/><TextField fx:id="ratingToFilter" prefWidth="55"/></HBox>
                    <Label text="Рік від/до" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <HBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="4"><TextField fx:id="yearFromFilter" prefWidth="70"/><Label text="—"/><TextField fx:id="yearToFilter" prefWidth="70"/></HBox>
                    <Label text="Додано від/до" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <HBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="5"><DatePicker fx:id="addedFromPicker"/><DatePicker fx:id="addedToPicker"/></HBox>
                    <CheckBox fx:id="localOnlyCheck" text="Тільки локальні" GridPane.columnIndex="2" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
                    <columnConstraints>
                        <ColumnConstraints minWidth="95"/><ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                        <ColumnConstraints minWidth="95"/><ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
                    </columnConstraints>
                </GridPane>
                <Label text="Підтримується класичний синтаксис: %текст%, =&quot;точна фраза&quot;, OR; також title:, author:, series:, genre:, file:, lang:." wrapText="true" style="-fx-text-fill: -mhl-muted-text; -fx-font-size: 11px;"/>
            </VBox>
        </content>
    </TitledPane>

    <Label fx:id="statusLabel" text="Введіть запит для пошуку" style="-fx-text-fill: -mhl-muted-text;"/>

    <VBox fx:id="resultsContainer" spacing="8" VBox.vgrow="ALWAYS">
        <!-- Authors are intentionally rendered in the left navigation panel. -->
        <VBox fx:id="authorsSection" visible="false" managed="false">
            <Label fx:id="authorsCountLabel" text="(0)"/>
            <ListView fx:id="authorsListView"/>
        </VBox>

        <HBox spacing="10" visible="true" managed="true">
            <VBox fx:id="seriesSection" spacing="4" HBox.hgrow="ALWAYS" maxHeight="130">
                <HBox spacing="6"><Label text="Серії" style="-fx-font-weight: bold;"/><Label fx:id="seriesCountLabel" text="(0)"/></HBox>
                <ListView fx:id="seriesListView" prefHeight="90"/>
            </VBox>
            <VBox fx:id="genresSection" spacing="4" HBox.hgrow="ALWAYS" maxHeight="130">
                <HBox spacing="6"><Label text="Жанри" style="-fx-font-weight: bold;"/><Label fx:id="genresCountLabel" text="(0)"/></HBox>
                <ListView fx:id="genresListView" prefHeight="90"/>
            </VBox>
        </HBox>

        <VBox fx:id="booksSection" spacing="4" VBox.vgrow="ALWAYS">
            <HBox spacing="6"><Label text="Книги" style="-fx-font-weight: bold;"/><Label fx:id="booksCountLabel" text="(0)"/></HBox>
            <TableView fx:id="booksTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="selectColumn" text="" prefWidth="42"/>
                    <TableColumn fx:id="titleColumn" text="Назва" prefWidth="260"/>
                    <TableColumn fx:id="authorColumn" text="Автор" prefWidth="200"/>
                    <TableColumn fx:id="seriesColumn" text="Серія" prefWidth="145"/>
                    <TableColumn fx:id="bookGenresColumn" text="Жанри" prefWidth="175"/>
                    <TableColumn fx:id="seqNumberColumn" text="№" prefWidth="45"/>
                    <TableColumn fx:id="yearColumn" text="Рік" prefWidth="65"/>
                    <TableColumn fx:id="localColumn" text="Статус" prefWidth="105"/>
                    <TableColumn fx:id="fileSizeColumn" text="Розмір" prefWidth="90"/>
                    <TableColumn fx:id="ratingColumn" text="Оцінка" prefWidth="95"/>
                    <TableColumn fx:id="progressColumn" text="Прогрес" prefWidth="80"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="8">
                <Button fx:id="loadMoreBooksButton" text="Завантажити ще" onAction="#onLoadMoreBooks" visible="false" managed="false"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
