<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.controller.SavedSearchesController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: -mhl-background;"
      prefWidth="500" prefHeight="540">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="ui.fxml.saved_searches.saved_searches" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <Button text="ui.fxml.saved_searches.smart_collection" onAction="#onNewSmartCollection"/>
    </HBox>

    <Separator/>

    <Label text="ui.fxml.saved_searches.save_regular_search" style="-fx-font-weight: bold;"/>
    <TextField fx:id="searchNameField" promptText="ui.fxml.saved_searches.title"/>
    <HBox spacing="5">
        <TextField fx:id="searchQueryField" promptText="ui.fxml.saved_searches.query" HBox.hgrow="ALWAYS"/>
        <Button text="ui.fxml.saved_searches.save" onAction="#onSaveSearch"/>
    </HBox>

    <Separator/>
    <ListView fx:id="savedSearchesListView" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT">
        <Button text="ui.fxml.saved_searches.close" onAction="#onClose"/>
    </HBox>
</VBox>
