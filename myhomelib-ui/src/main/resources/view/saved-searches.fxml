<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myhomelibcorp.ui.controller.SavedSearchesController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: -mhl-background;"
      prefWidth="500" prefHeight="540">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="💾 Збережені пошуки" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <Button text="◈ Розумна колекція" onAction="#onNewSmartCollection"/>
    </HBox>

    <Separator/>

    <Label text="Зберегти звичайний пошук:" style="-fx-font-weight: bold;"/>
    <TextField fx:id="searchNameField" promptText="Назва..."/>
    <HBox spacing="5">
        <TextField fx:id="searchQueryField" promptText="Запит..." HBox.hgrow="ALWAYS"/>
        <Button text="💾 Зберегти" onAction="#onSaveSearch"/>
    </HBox>

    <Separator/>
    <ListView fx:id="savedSearchesListView" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT">
        <Button text="Закрити" onAction="#onClose"/>
    </HBox>
</VBox>
