<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.myhomelibcorp.ui.operation.OperationCenterController"
            style="-fx-background-color: -mhl-panel;">
    <top>
        <VBox spacing="8">
            <padding><Insets top="14" right="14" bottom="8" left="14"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="ui.fxml.operation_center_workspace.operations" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="ui.fxml.operation_center_workspace.refresh" onAction="#onRefresh"/>
                <Button text="ui.fxml.operation_center_workspace.clear_completed" onAction="#onClearCompleted"/>
            </HBox>
            <Label fx:id="summaryLabel" text="ui.fxml.operation_center_workspace.no_active_operations"/>
        </VBox>
    </top>
    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.68">
            <TableView fx:id="operationsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="stateColumn" text="ui.fxml.operation_center_workspace.state" prefWidth="125"/>
                    <TableColumn fx:id="titleColumn" text="ui.fxml.operation_center_workspace.operation" prefWidth="210"/>
                    <TableColumn fx:id="kindColumn" text="ui.fxml.operation_center_workspace.type" prefWidth="155"/>
                    <TableColumn fx:id="stageColumn" text="ui.fxml.operation_center_workspace.stage" prefWidth="155"/>
                    <TableColumn fx:id="progressColumn" text="ui.fxml.operation_center_workspace.progress" prefWidth="190"/>
                    <TableColumn fx:id="startedColumn" text="ui.fxml.operation_center_workspace.start" prefWidth="90"/>
                    <TableColumn fx:id="finishedColumn" text="ui.fxml.operation_center_workspace.finalizing" prefWidth="90"/>
                    <TableColumn fx:id="durationColumn" text="ui.fxml.operation_center_workspace.duration" prefWidth="90"/>
                    <TableColumn fx:id="resultColumn" text="ui.fxml.operation_center_workspace.result" prefWidth="240"/>
                </columns>
            </TableView>
            <TextArea fx:id="detailsArea" editable="false" wrapText="true" promptText="ui.fxml.operation_center_workspace.select_an_operation_to_view_details"/>
        </SplitPane>
    </center>
</BorderPane>
