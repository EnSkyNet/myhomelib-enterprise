    <dependencies>
        <dependency>
            <groupId>com.myhomelibcorp</groupId>
            <artifactId>myhomelib-shared</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <dependency>
            <groupId>com.myhomelibcorp</groupId>
            <artifactId>myhomelib-domain</artifactId>
            <version>${project.parent.version}</version>
